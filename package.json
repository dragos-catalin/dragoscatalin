{
  "name": "dragoscatalin",
  "version": "2.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev --port 24789",
    "build": "next build",
    "start": "next start --port 24789",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "node scripts/check-first-load.mjs",
    "tracker:check": "node scripts/check-tracker.mjs",
    "shots": "node scripts/shots.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "lh": "node scripts/lighthouse-local.mjs",
    "scan:contrast": "node scripts/contrast-scan.mjs",
    "scan:layout": "node scripts/layout-scan.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.1",
    "@sentry/nextjs": "11.4.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "2.1.1",
    "feed": "6.0.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "schema-dts": "2.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/playwright": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
