# Public site URL (used for canonical/OG/sitemap). Defaults to https://dragoscatalin.ro
NEXT_PUBLIC_SITE_URL=https://dragoscatalin.ro

# GitHub fine-grained PAT, read-only "Metadata" (+ "Contents" for private repos you list).
# Without it, live stats are skipped and the registry's static data is shown.
GITHUB_TOKEN=

# Contact form via Resend. Without RESEND_API_KEY the form shows a mailto fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@dragoscatalin.ro
CONTACT_FROM_EMAIL=site@dragoscatalin.ro

# Cloudflare Turnstile (bot protection). Optional; form works without it (honeypot only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional). When unset, Sentry is fully disabled.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
