# Public site URL (used for canonical/OG/sitemap). Defaults to https://dragoscatalin.ro
NEXT_PUBLIC_SITE_URL=https://dragoscatalin.ro

# GitHub fine-grained PAT, read-only "Metadata" (+ "Contents" for private repos you list).
# Without it, live stats are skipped and the registry's static data is shown.
GITHUB_TOKEN=

# Contact form via Brivio POST /v1/email/send (API key scope emails:send; the
# From domain must be a verified Brivio sending domain). Without BRIVIO_API_KEY
# or CONTACT_FROM_EMAIL the form shows a mailto fallback.
BRIVIO_API_KEY=
BRIVIO_API_URL=https://api.brivio.ro
CONTACT_TO_EMAIL=catalin@dragoscatalin.ro
CONTACT_FROM_EMAIL=contact@dragoscatalin.ro

# Phone notification after a delivered message: signed POST to the homepi
# Tailscale Funnel hook (vmui docs/home-assistant.md). Optional; both or none.
CONTACT_HOOK_URL=https://homepi.taild1532d.ts.net/hooks/contact
CONTACT_HOOK_SECRET=

# Sentry (optional). When unset, Sentry is fully disabled.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
