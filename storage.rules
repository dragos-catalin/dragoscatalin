rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Contract signed PDFs - allow unlimited file size
    match /contracts/{linkId}/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
