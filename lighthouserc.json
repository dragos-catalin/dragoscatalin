{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:24789/",
        "http://localhost:24789/projects",
        "http://localhost:24789/projects/codai",
        "http://localhost:24789/about",
        "http://localhost:24789/open-source"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.98, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 1200, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100 }],
        "errors-in-console": "error"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
