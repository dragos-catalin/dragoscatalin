rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow only authenticated users (including anonymous) to create contact submissions
    match /contact_submissions/{document} {
      allow create: if request.auth != null 
                    && request.auth.token.firebase.sign_in_provider == 'anonymous';
      // Allow reading for checking notifications (you can add custom claims for admin users)
      // For now, this allows authenticated users to check for new messages
      // In production, you should add custom user claims to restrict this to admin only
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
