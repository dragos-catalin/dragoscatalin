rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow only authenticated users (including anonymous) to create contact submissions
    match /contact_submissions/{document} {
      allow create: if request.auth != null 
                    && request.auth.token.firebase.sign_in_provider == 'anonymous';
      // Allow reading for checking notifications (you can add custom claims for admin users)
      // For now, this allows authenticated users to check for new messages
      // In production, you should add custom user claims to restrict this to admin only
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Dashboard: Client links - admin can manage, anyone can read (for public forms)
    match /clientLinks/{linkId} {
      allow read: if true; // Public forms need to read link data
      allow create, update: if request.auth != null 
                            && request.auth.token.email == "vladulescu.catalin@gmail.com";
      allow delete: if request.auth != null 
                    && request.auth.token.email == "vladulescu.catalin@gmail.com";
    }
    
    // Dashboard: Form responses - anyone can create (via public forms), only admin can read
    match /formResponses/{responseId} {
      allow create: if true; // Allow public form submissions and contract signatures
      allow read, update, delete: if request.auth != null 
                                  && request.auth.token.email == "vladulescu.catalin@gmail.com";
    }
    
    // Dashboard: Templates - only admin can manage, public can read active templates
    match /templates/{templateId} {
      // Allow public read for active templates (needed for public forms/contracts)
      allow read: if resource.data.status == "active" 
                  || (request.auth != null && request.auth.token.email == "vladulescu.catalin@gmail.com");
      allow write: if request.auth != null 
                   && request.auth.token.email == "vladulescu.catalin@gmail.com";
    }
    
    // Dashboard: Clients - only admin can manage
    match /clients/{clientId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email == "vladulescu.catalin@gmail.com";
    }
    
    // User Profiles - users can read/write their own profile only
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
